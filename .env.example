# Flask
SECRET_KEY=replace-with-a-long-random-string
FLASK_ENV=development
PORT=5000

# Database — Neon PostgreSQL in production. Local fallback: sqlite:///vibe_eye.db
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# CORS — comma-separated frontend origins
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080

# Gemini — image describe / read / visual questions only
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Groq — conversation and phone actions
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Maps: osm works without a key.
MAPS_PROVIDER=osm
MAPS_API_KEY=

# YOLO
YOLO_MODEL=yolov8n.pt
YOLO_CONFIDENCE=0.35

# Optional Twilio SMS for emergency notifications
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# JWT
JWT_EXPIRES_HOURS=24

# Optional Daily fallback if the Admin API keys page is empty. Prefer Admin → Daily calling key.
DAILY_API_KEY=

# Admin website (PC only) — open /admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
